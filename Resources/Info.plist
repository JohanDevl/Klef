<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.klef.app</string>
	<key>CFBundleName</key>
	<string>Klef</string>
	<key>CFBundleDisplayName</key>
	<string>Klef</string>
	<key>CFBundleExecutable</key>
	<string>klef</string>
	<key>CFBundleIconFile</key>
	<string>Klef</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both version keys are placeholders. bundle-app.sh substitutes them in
	     the copy it puts inside Klef.app: the marketing version comes from
	     version.txt (maintained by release-please), the build number from the
	     commit count. Editing them here has no effect. -->
	<key>CFBundleShortVersionString</key>
	<string>__MARKETING_VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD_NUMBER__</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT — © 2026 Johan Devlaminck</string>
	<key>NSInputMonitoringUsageDescription</key>
	<string>Klef detects which keyboard you're typing on so it can switch the matching input source. It never reads keystroke content.</string>
</dict>
</plist>
